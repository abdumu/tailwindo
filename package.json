{
  "name": "tailwindo",
  "version": "1.0.0",
  "description": "Convert Bootstrap CSS to Tailwind CSS",
  "main": "dist/cli.js",
  "bin": {
    "tailwindo": "dist/cli.js"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:ui": "npx playwright test",
    "test:watch": "vitest",
    "lint": "eslint src",
    "calibrate:samples": "tsx scripts/calibrate-samples.ts",
    "regen:templates": "npm run calibrate:samples"
  },
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abdumu/tailwindo.git"
  },
  "author": "Awssat",
  "license": "MIT",
  "dependencies": {
    "@babel/parser": "^7.24.0",
    "@babel/traverse": "^7.29.0",
    "@vue/compiler-sfc": "^3.4.21",
    "chalk": "^5.3.0",
    "commander": "^12.0.0",
    "diff": "^5.2.0",
    "glob": "^10.3.10",
    "parse5": "^7.1.2",
    "svelte": "^4.2.12"
  },
  "devDependencies": {
    "@babel/types": "^7.24.0",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/cli": "^4.2.1",
    "@types/babel__traverse": "^7.28.0",
    "@types/diff": "^5.0.9",
    "@types/glob": "^8.1.0",
    "@types/node": "^20.11.25",
    "@types/parse5": "^6.0.3",
    "@typescript-eslint/eslint-plugin": "^8.57.0",
    "@typescript-eslint/parser": "^8.57.0",
    "eslint": "^8.57.0",
    "http-server": "^14.1.1",
    "prettier": "^3.2.5",
    "tailwindcss": "^4.2.1",
    "tsup": "^8.0.2",
    "tsx": "^4.21.0",
    "typescript": "^5.4.2",
    "typescript-eslint": "^8.57.0",
    "vitest": "^1.3.1"
